# Sesame MuHack — ESP-IDF 5.5 + Arduino come componente, Lolin S2 Mini (ESP32-S2FNR2)

# Scheda: 4 MB di flash
CONFIG_IDF_TARGET="esp32s2"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Partizioni come huge_app.csv della build PlatformIO (app da 3 MB)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Arduino come componente: setup()/loop() avviati da Arduino, tick a 1000 Hz (obbligatorio)
CONFIG_AUTOSTART_ARDUINO=y
CONFIG_FREERTOS_HZ=1000

# PSRAM integrata da 2 MB (come le librerie Arduino precompilate per la S2)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
# Allocazioni da 4 KB in su in PSRAM (default 16 KB): la RAM interna resta a WiFi, TinyUSB e stack
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
# Buffer di WiFi e lwIP anche in PSRAM: servire la pagina web portava la RAM interna a 8 KB
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Ottimizzazione per dimensione (come Arduino) e avvisi -Wall non bloccanti oltre il default di IDF 5.5
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_DISABLE_DEFAULT_ERRORS=y

# La USB nativa non è usata da Arduino (ARDUINO_USB_CDC_ON_BOOT non definito: Serial = UART0):
# appartiene a esp_tinyusb, con 2 porte CDC. ttyACM0 = micro-ROS, ttyACM1 = log ESP_LOGx.
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=2

# micro-ROS: middleware Micro XRCE-DDS, nessuna interfaccia di rete (trasporto custom su USB CDC)
CONFIG_MICRO_ROS_ESP_XRCE_DDS_MIDDLEWARE=y
CONFIG_MICRO_ROS_ESP_UART_TRANSPORT=y

# RAM interna: codice di WiFi e lwIP in flash invece che in IRAM (sulla S2 IRAM e DRAM
# sono la stessa memoria). Libera spazio per micro-ROS; il WiFi del portale non ne risente.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_LWIP_IRAM_OPTIMIZATION=n
